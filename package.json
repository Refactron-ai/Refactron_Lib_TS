{
  "name": "refactron",
  "version": "0.2.2",
  "description": "Safety-first refactoring — finds, fixes, and verifies changes are safe before touching the filesystem",
  "author": "Om Sherikar <omsherikar0229@gmail.com>",
  "bin": {
    "refactron": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Refactron-ai/Refactron_Lib_TS.git"
  },
  "homepage": "https://github.com/Refactron-ai/Refactron_Lib_TS#readme",
  "bugs": {
    "url": "https://github.com/Refactron-ai/Refactron_Lib_TS/issues"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && chmod +x dist/cli/index.js && npm run build:copy-py",
    "build:copy-py": "mkdir -p dist/verify/checks/_py dist/transform/transforms/python/_py && cp src/verify/checks/_py/*.py dist/verify/checks/_py/ && cp src/transform/transforms/python/_py/*.py dist/transform/transforms/python/_py/ 2>/dev/null || true",
    "build:watch": "tsc --project tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/ --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:verification": "vitest run tests/verification/",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build && npm run typecheck && npm run lint && npm test"
  },
  "keywords": [
    "refactoring",
    "python",
    "typescript",
    "code-quality",
    "ast",
    "cli",
    "safety",
    "verification",
    "blast-radius",
    "autofix",
    "static-analysis"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "chalk": "^5.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "cosmiconfig": "^9.0.1",
    "diff": "^9.0.0",
    "execa": "^9.6.1",
    "glob": "^13.0.6",
    "ignore": "^7.0.5",
    "ink": "^5.0.0",
    "ink-spinner": "^5.0.0",
    "ink-table": "^3.0.0",
    "js-yaml": "^4.0.0",
    "react": "^19.2.6",
    "semver": "^7.0.0",
    "tree-sitter": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "ts-morph": "^28.0.0",
    "typescript": "^5.4.0",
    "write-file-atomic": "^8.0.0"
  },
  "devDependencies": {
    "@types/diff": "^5.0.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.15",
    "@types/semver": "^7.0.0",
    "@types/write-file-atomic": "^4.0.3",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
