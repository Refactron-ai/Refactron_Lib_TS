{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Refactron",
  "description": "The verification layer for AI code change. Prove that any change — your AI agent's, a codemod's, or your own — preserved behavior, with a reproducible record of why it's safe.",
  "colors": {
    "primary": "#141416",
    "light": "#EAE7DE",
    "dark": "#141416"
  },
  "fonts": {
    "body": {
      "family": "Space Grotesk"
    },
    "heading": {
      "family": "Space Grotesk"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"]
  },
  "logo": {
    "light": "/logo/refactron-wordmark-dark.svg",
    "dark": "/logo/refactron-wordmark-light.svg"
  },
  "favicon": {
    "light": "/logo/refactron-symbol-dark.svg",
    "dark": "/logo/refactron-symbol-light.svg"
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "pages": ["overview", "quickstart"]
      },
      {
        "group": "Verification",
        "pages": [
          "verification/verify-diff",
          "verification/mcp-server",
          "verification/verdicts",
          "verification/preflight"
        ]
      },
      {
        "group": "Concepts",
        "pages": ["concepts/safety-model", "concepts/why-no-llm"]
      },
      {
        "group": "CLI",
        "pages": ["cli/reference"]
      },
      {
        "group": "Configuration",
        "pages": ["configuration", "configuration/refactronrc"]
      },
      {
        "group": "Migration mode",
        "pages": [
          "transforms/index",
          "transforms/callback-to-async-await",
          "transforms/format-to-fstring",
          "transforms/manual-typecheck-to-hints",
          "transforms/deprecated-api-requests-to-httpx",
          "transforms/class-to-dataclass",
          "transforms/var-to-const-let",
          "transforms/promise-chains-to-async",
          "transforms/implicit-any",
          "transforms/commonjs-to-esm",
          "transforms/promise-constructor-to-async",
          "transforms/super-no-args",
          "transforms/lru-cache-to-cache",
          "transforms/pep585-generics",
          "transforms/pep604-optional-union",
          "transforms/datetime-utc-alias",
          "transforms/yield-from-for-loop",
          "transforms/indexof-to-includes",
          "transforms/object-assign-to-spread",
          "transforms/string-concat-to-template-literal",
          "transforms/vue-set-delete-to-assignment"
        ]
      },
      {
        "group": "Reference",
        "pages": ["faq", "changelog", "reference/performance", "reference/citations"]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Issues",
        "href": "https://github.com/Refactron-ai/Refactron_Lib_TS/issues"
      }
    ],
    "primary": {
      "type": "button",
      "label": "GitHub",
      "href": "https://github.com/Refactron-ai/Refactron_Lib_TS"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Refactron-ai/Refactron_Lib_TS",
      "x": "https://x.com/refactron",
      "linkedin": "https://www.linkedin.com/company/refactron",
      "discord": "https://discord.gg/HY8WawSH"
    }
  }
}
