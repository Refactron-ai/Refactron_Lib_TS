{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Refactron",
  "description": "Prove that any change, your AI agent's, a codemod's, or your own, preserved behavior. Refactron runs your real tests in an isolated shadow tree and lands only on green, with a reproducible record of why it's safe.",
  "colors": {
    "primary": "#141416",
    "light": "#E9E6DF",
    "dark": "#141416"
  },
  "fonts": {
    "body": {
      "family": "Space Grotesk"
    },
    "heading": {
      "family": "Space Grotesk"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "logo": {
    "light": "/logo/refactron-wordmark-dark.svg",
    "dark": "/logo/refactron-wordmark-light.svg"
  },
  "favicon": {
    "light": "/logo/refactron-symbol-light.svg",
    "dark": "/logo/refactron-symbol-dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "overview",
              "quickstart",
              "faq"
            ]
          },
          {
            "group": "Verification",
            "pages": [
              "verification/verify-diff",
              "verification/mcp-server",
              "verification/verdicts"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/safety-model",
              "concepts/why-no-llm"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "changelog"
            ]
          }
        ]
      },
      {
        "tab": "MCP",
        "icon": "/assets/clients/mcp.svg",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "mcp/overview",
              "mcp/quickstart"
            ]
          },
          {
            "group": "Connect your client",
            "pages": [
              {
                "group": "Claude",
                "icon": "/assets/clients/claude.svg",
                "pages": [
                  "mcp/claude-code",
                  "mcp/claude-desktop"
                ]
              },
              "mcp/codex",
              "mcp/cursor",
              "mcp/vscode",
              "mcp/gemini-cli",
              "mcp/windsurf",
              "mcp/other-clients"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "mcp/tool-reference"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Issues",
        "href": "https://github.com/Refactron-ai/refactron/issues"
      }
    ],
    "primary": {
      "type": "button",
      "label": "GitHub",
      "href": "https://github.com/Refactron-ai/refactron"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Refactron-ai/refactron",
      "x": "https://x.com/refactron",
      "linkedin": "https://www.linkedin.com/company/refactron",
      "discord": "https://discord.gg/HY8WawSH"
    }
  }
}
